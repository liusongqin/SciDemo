{
	admin off
	auto_https off
}

http://:8088 {
	bind 127.0.0.1

	@api path /api /api/*
	handle @api {
		reverse_proxy 127.0.0.1:8000 {
			# Only the loopback frpc gateway can reach this listener.
			trusted_proxies 127.0.0.1/32
			flush_interval -1
		}
	}

	handle {
		root * {$SCIDEMO_FRONTEND_ROOT}
		try_files {path} /index.html
		file_server
	}

	header X-Content-Type-Options nosniff
}
